@model Thực_Hành_Web.Models.Learner
@{
    ViewData["Title"] = "Sửa người học";
}

<section class="page-heading"><div><a asp-action="Index" class="back-link">← Danh sách người học</a><p class="eyebrow mt-4">HỒ SƠ NGƯỜI HỌC · #@Model.LearnerID</p><h1>Sửa thông tin người học</h1><p class="text-secondary mb-0">Cập nhật hồ sơ người học.</p></div></section>

<form asp-action="Edit" asp-route-id="@Model.LearnerID" method="post" class="student-form learner-form">
    <input type="hidden" asp-for="LearnerID" />
    <div asp-validation-summary="All" class="validation-summary" aria-live="polite"></div>
    <div class="form-grid">
        <div class="form-field"><label asp-for="FirstMidName" class="form-label"></label><input asp-for="FirstMidName" class="form-control" /><span asp-validation-for="FirstMidName" class="field-validation"></span></div>
        <div class="form-field"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="field-validation"></span></div>
        <div class="form-field"><label asp-for="MajorID" class="form-label"></label><select asp-for="MajorID" class="form-select" asp-items="ViewBag.Majors"><option value="">Chọn chuyên ngành</option></select><span asp-validation-for="MajorID" class="field-validation"></span></div>
        <div class="form-field"><label asp-for="EnrollmentDate" class="form-label"></label><input asp-for="EnrollmentDate" class="form-control" /><span asp-validation-for="EnrollmentDate" class="field-validation"></span></div>
    </div>
    <div class="form-actions"><a asp-action="Index" class="btn btn-light">Hủy</a><button type="submit" class="btn btn-primary btn-add">Lưu thay đổi</button></div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
