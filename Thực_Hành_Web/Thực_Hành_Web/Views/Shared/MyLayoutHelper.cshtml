<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Cổng quản lý danh sách sinh viên" />
    <title>@ViewData["Title"] - Cổng sinh viên</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" />
</head>
<body class="sb-nav-fixed">
    <partial name="TopNav" />
    <div id="layoutSidenav">
        <aside id="layoutSidenav_nav">@await Component.InvokeAsync("Render")</aside>
        <div id="layoutSidenav_content">
            <main>@RenderBody()</main>
            <footer class="sb-footer"><partial name="Footer" /></footer>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/scripts.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
