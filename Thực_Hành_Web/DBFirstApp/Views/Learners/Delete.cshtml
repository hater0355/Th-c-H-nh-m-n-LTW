@model DBFirstApp.Models.Learner
@{
    ViewData["Title"] = "Xóa người học";
    var hasEnrollments = Model.Enrollments.Count > 0;
}

<div class="mb-4"><a asp-action="Index" class="link-secondary text-decoration-none">← Danh sách người học</a><h1 class="h2 mt-3">Xác nhận xóa người học</h1></div>
<div class="card border-0 shadow-sm"><div class="card-body p-4">
    @if (TempData["DeleteError"] is string error)
    {
        <div class="alert alert-warning">@error</div>
    }
    else if (hasEnrollments)
    {
        <div class="alert alert-warning">Người học có @Model.Enrollments.Count đăng ký khóa học, không thể xóa.</div>
    }
    else
    {
        <div class="alert alert-danger">Bạn có chắc chắn muốn xóa người học này?</div>
    }
    <dl class="row mb-0">
        <dt class="col-sm-3">Tên</dt><dd class="col-sm-9">@Model.FirstMidName</dd>
        <dt class="col-sm-3">Họ</dt><dd class="col-sm-9">@Model.LastName</dd>
        <dt class="col-sm-3">Chuyên ngành</dt><dd class="col-sm-9">@Model.Major.MajorName</dd>
        <dt class="col-sm-3">Ngày nhập học</dt><dd class="col-sm-9">@Model.EnrollmentDate.ToString("dd/MM/yyyy")</dd>
    </dl>
</div><div class="card-footer bg-white border-0 px-4 pb-4 d-flex gap-2">
    <a asp-action="Index" class="btn btn-light">Quay lại</a>
    @if (!hasEnrollments && TempData["DeleteError"] is null)
    {
        <form asp-action="Delete" asp-route-id="@Model.LearnerId" method="post"><input type="hidden" asp-for="LearnerId" /><button type="submit" class="btn btn-danger">Xóa người học</button></form>
    }
</div></div>

