@model IEnumerable<DBFirstApp.Models.Learner>
@{
    ViewData["Title"] = "Danh sách người học";
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
    <div><div class="text-primary small fw-bold text-uppercase">Database First</div><h1 class="h2 mb-1">Danh sách người học</h1><p class="text-secondary mb-0">Hồ sơ người học được đọc trực tiếp từ cơ sở dữ liệu School.</p></div>
    <a asp-action="Create" class="btn btn-primary">+ Thêm người học</a>
</div>

@if (TempData["DeleteError"] is string error)
{
    <div class="alert alert-warning" role="alert">@error</div>
}

<div class="table-responsive bg-white rounded-3 shadow-sm border">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Mã</th><th>Tên</th><th>Họ</th><th>Chuyên ngành</th><th>Ngày nhập học</th><th>Chức năng</th></tr></thead>
        <tbody>
        @foreach (var learner in Model)
        {
            <tr>
                <td class="text-secondary">#@learner.LearnerId</td><td class="fw-semibold">@learner.FirstMidName</td><td>@learner.LastName</td><td>@learner.Major.MajorName</td><td>@learner.EnrollmentDate.ToString("dd/MM/yyyy")</td>
                <td class="text-nowrap"><a asp-action="Edit" asp-route-id="@learner.LearnerId" class="link-primary">Sửa</a><span class="text-secondary mx-2">|</span><a asp-action="Delete" asp-route-id="@learner.LearnerId" class="link-danger">Xóa</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>

