@model DBFirstApp.Models.Learner
@{
    ViewData["Title"] = "Thêm người học";
}

<div class="mb-4"><a asp-action="Index" class="link-secondary text-decoration-none">← Danh sách người học</a><h1 class="h2 mt-3">Thêm người học</h1></div>
<form asp-action="Create" method="post" class="card border-0 shadow-sm"><div class="card-body p-4">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="row g-3">
        <div class="col-md-6"><label asp-for="FirstMidName" class="form-label"></label><input asp-for="FirstMidName" class="form-control" /><span asp-validation-for="FirstMidName" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="MajorId" class="form-label">Chuyên ngành</label><select asp-for="MajorId" asp-items="ViewBag.MajorId" class="form-select"><option value="">Chọn chuyên ngành</option></select><span asp-validation-for="MajorId" class="text-danger small"></span></div>
        <div class="col-md-6"><label asp-for="EnrollmentDate" class="form-label"></label><input asp-for="EnrollmentDate" class="form-control" /><span asp-validation-for="EnrollmentDate" class="text-danger small"></span></div>
    </div>
</div><div class="card-footer bg-white border-0 px-4 pb-4 d-flex gap-2"><button type="submit" class="btn btn-primary">Thêm người học</button><a asp-action="Index" class="btn btn-light">Hủy</a></div></form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

