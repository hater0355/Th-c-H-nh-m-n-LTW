@model IEnumerable<Lap_2.Models.MenuItem>

<aside id="layoutSidenav_nav" class="sidenav">
    <nav class="sidenav-menu" aria-label="Main navigation">
        <div class="menu-heading">CORE</div>
        <a class="sidenav-link" asp-controller="Home" asp-action="Index"><i class="fa-solid fa-gauge-high"></i>Dashboard</a>
        <div class="menu-heading">ADDONS</div>
        @foreach (var item in Model)
        {
            <a class="sidenav-link" href="@item.Link"><i class="fa-solid fa-folder"></i>@item.Name</a>
        }
    </nav>
</aside>
