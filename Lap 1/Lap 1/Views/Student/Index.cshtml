@model IReadOnlyList<Student>
@using Lap_1.Models
@{
    ViewData["Title"] = "Danh sách sinh viên";

    string BranchName(Branch? branch) => branch switch
    {
        Branch.IT => "CNTT",
        Branch.BE => "Kinh tế",
        Branch.CE => "Công trình",
        Branch.EE => "Điện - Điện tử",
        _ => "Chưa xác định"
    };
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <p class="text-uppercase text-primary fw-semibold small mb-1">Quản trị đào tạo</p>
        <h1 class="h2 mb-1">Danh sách sinh viên</h1>
        <p class="text-secondary mb-0">Hiện có @Model.Count sinh viên trong danh sách.</p>
    </div>
    <a asp-controller="Student" asp-action="Create" class="btn btn-primary">Thêm sinh viên</a>
</div>

<div class="table-responsive bg-white border rounded-3 shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col">Mã</th>
                <th scope="col">Sinh viên</th>
                <th scope="col">Ngày sinh</th>
                <th scope="col">Ngành</th>
                <th scope="col">Giới tính</th>
                <th scope="col">Hệ đào tạo</th>
                <th scope="col">Địa chỉ</th>
                <th scope="col">Email</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td class="fw-semibold">@student.Id</td>
                <td>
                    <div class="d-flex align-items-center gap-2">
                        @if (!string.IsNullOrWhiteSpace(student.AvatarPath))
                        {
                            <img src="@student.AvatarPath" alt="Ảnh đại diện @student.Name" class="student-avatar" />
                        }
                        else
                        {
                            <span class="student-avatar student-avatar-placeholder" aria-hidden="true">@student.Name.FirstOrDefault()</span>
                        }
                        <span>@student.Name</span>
                    </div>
                </td>
                <td>@(student.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")</td>
                <td>@BranchName(student.Branch)</td>
                <td>@(student.Gender == Gender.Male ? "Nam" : student.Gender == Gender.Female ? "Nữ" : "—")</td>
                <td>@(student.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                <td>@(string.IsNullOrWhiteSpace(student.Address) ? "—" : student.Address)</td>
                <td><a href="mailto:@student.Email">@student.Email</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
