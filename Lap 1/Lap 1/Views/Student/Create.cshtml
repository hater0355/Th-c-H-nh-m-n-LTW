@model StudentCreateViewModel
@using Lap_1.Models
@{
    ViewData["Title"] = "Thêm sinh viên";
}

<div class="mb-4">
    <a asp-controller="Student" asp-action="Index" class="text-decoration-none">← Danh sách sinh viên</a>
    <p class="text-uppercase text-primary fw-semibold small mt-4 mb-1">Quản trị đào tạo</p>
    <h1 class="h2 mb-1">Thêm sinh viên</h1>
    <p class="text-secondary mb-0">Nhập thông tin sinh viên mới vào biểu mẫu bên dưới.</p>
</div>

<form asp-controller="Student" asp-action="Create" method="post" enctype="multipart/form-data" class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Student.Name" class="form-label"></label>
                <input asp-for="Student.Name" class="form-control" placeholder="Nguyễn Văn An" autocomplete="name" />
                <span asp-validation-for="Student.Name" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Student.Email" class="form-label"></label>
                <input asp-for="Student.Email" class="form-control" placeholder="ten@truong.edu.vn" autocomplete="email" />
                <span asp-validation-for="Student.Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Student.Password" class="form-label"></label>
                <input asp-for="Student.Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Student.Password" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Student.DateOfBirth" class="form-label"></label>
                <input asp-for="Student.DateOfBirth" type="date" class="form-control" />
                <span asp-validation-for="Student.DateOfBirth" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Student.Branch" class="form-label"></label>
                <select asp-for="Student.Branch" asp-items="Html.GetEnumSelectList<Branch>()" class="form-select">
                    <option value="">Chọn ngành học</option>
                </select>
                <span asp-validation-for="Student.Branch" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Avatar" class="form-label"></label>
                <input asp-for="Avatar" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" class="form-control" />
                <div class="form-text">JPG, PNG hoặc WebP, tối đa 5 MB.</div>
                <span asp-validation-for="Avatar" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <span class="form-label d-block">Giới tính</span>
                <div class="d-flex gap-4 pt-2">
                    @foreach (var gender in Enum.GetValues<Gender>())
                    {
                        <div class="form-check">
                            <input asp-for="Student.Gender" type="radio" value="@gender" id="gender-@gender" class="form-check-input" />
                            <label for="gender-@gender" class="form-check-label">@(gender == Gender.Male ? "Nam" : "Nữ")</label>
                        </div>
                    }
                </div>
                <span asp-validation-for="Student.Gender" class="text-danger small"></span>
            </div>
            <div class="col-md-6 d-flex align-items-center pt-md-4">
                <div class="form-check">
                    <input asp-for="Student.IsRegular" class="form-check-input" />
                    <label asp-for="Student.IsRegular" class="form-check-label"></label>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="Student.Address" class="form-label"></label>
                <textarea asp-for="Student.Address" class="form-control" rows="3" placeholder="Số nhà, đường, quận/huyện"></textarea>
                <span asp-validation-for="Student.Address" class="text-danger small"></span>
            </div>
        </div>
    </div>
    <div class="card-footer bg-white border-0 px-4 pb-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Lưu sinh viên</button>
        <a asp-controller="Student" asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
